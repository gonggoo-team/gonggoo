# Naver Map API Keys
# Get your API keys from https://www.ncloud.com/product/applicationService/maps
# 1. Go to NCP Console (https://console.ncloud.com)
# 2. Create Application (Maps)
# 3. Get Client ID and Client Secret

# Note: These are exposed to client (EXPO_PUBLIC_ prefix)
# For production, use server-side proxy to protect Client Secret
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=your_client_id_here
EXPO_PUBLIC_NAVER_MAP_CLIENT_SECRET=your_client_secret_here

# Location Service Configuration
# Set to 'true' to use mock GPS data (for testing without real location)
# Default (false or not set): Use real GPS from emulator/device
EXPO_PUBLIC_USE_MOCK_LOCATION=false
