spring:
  datasource:
    # Docker 내부 통신용 'db' 호스트 사용
    url: jdbc:mysql://db:3306/gonggoo_db?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul
    username: root
    password: password1234 # 🚨 실제 비밀번호로 변경 필수
    driver-class-name: com.mysql.cj.jdbc.Driver

  jpa:
    hibernate:
      ddl-auto: validate
    properties:
      hibernate:
        dialect: org.hibernate.dialect.MySQLDialect
        show_sql: false # 운영 환경에서는 성능/보안상 끄는 것이 좋음

  data:
    redis:
      host: redis # Docker 내부 통신용 'redis' 호스트
      port: 6379

  h2:
    console:
      enabled: false

logging:
  level:
    org.hibernate.SQL: info # 운영에선 debug 지양

jwt:
  issuer: gonggoo
  # 🚨 운영용 강력한 비밀키로 반드시 변경하세요!
  secret: "bXktc3VwZXItc2VjcmV0LWtleS1mb3ItdGVzdGluZy0xMjM0NS1hbmQtaXQtbXVzdC1iZS1sb25nLWVub3VnaA=="
  expireSeconds: 31536000
  refreshExpireSeconds: 31536000